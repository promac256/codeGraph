# --- Database (your managed Postgres — NOT UiPath Data Service) ---
DATABASE_URL=postgres://user:pass@localhost:5432/recon

# --- UiPath External Application (OAuth 2.0 client credentials) ---
# Register an External Application in Automation Cloud → Admin → External Applications.
# Tokens expire in 1 hour and there is NO refresh token (client-credentials flow) — the
# SDK client caches and re-fetches automatically.
UIPATH_BASE_URL=https://cloud.uipath.com
UIPATH_ORG=your-org
UIPATH_TENANT=your-tenant
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=
# Space-separated OAuth scopes, e.g. "OR.Jobs OR.Queues OR.Assets OR.Tasks"
UIPATH_SCOPES=OR.Jobs OR.Queues OR.Assets OR.Tasks

# --- UiPath Document Understanding (separate REST API; not covered by the SDK) ---
UIPATH_DU_BASE_URL=https://du.uipath.com
UIPATH_DU_API_KEY=
